{
  "name": "zmkshieldwizard",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "astro preview",
    "test": "vitest",
    "test:node": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm -s -w -r test:node && pnpm -s test:e2e",
    "astro": "astro",
    "check": "pnpm -s check:vue && vue-tsc --noEmit && astro check",
    "check:vue": "jiti scripts/check-vue-sfc.ts",
    "layouts": "jiti scripts/updatePhysicalLayouts.ts",
    "smoke": "jiti scripts/smoke.ts",
    "generate-types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@vueuse/core": "14.4.0",
    "jiti": "2.7.0",
    "reka-ui": "2.10.1",
    "typescript": "7.0.2",
    "unplugin-fluent-vue": "1.4.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.1.4",
    "@astrojs/starlight": "0.41.4",
    "@astrojs/vue": "7.0.1",
    "@fluent/bundle": "0.19.1",
    "@iconify-json/lucide": "1.2.120",
    "@nuxt/ui": "4.10.0",
    "@standard-schema/spec": "1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@vue/devtools-api": "^8.1.5",
    "astro": "7.1.3",
    "fluent-vue": "3.8.2",
    "jszip": "3.10.1",
    "lz-string": "1.5.0",
    "nanotar": "0.3.0",
    "pinia": "4.0.2",
    "tailwindcss": "4.3.3",
    "ulidx": "2.4.1",
    "vue": "3.5.40",
    "vue-turnstile": "1.0.11",
    "wrangler": "4.114.0"
  }
}
