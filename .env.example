# Copy to .env and fill in values. Only PUBLIC_TURNSTILE_SITEKEY is required.

# Public Turnstile site key — rendered in the client-side captcha widget.
# Required: `astro dev` and `astro build` fail without it.
PUBLIC_TURNSTILE_SITEKEY=

# Server-side Turnstile secret used for siteverify.
# Optional: when unset, captcha verification is skipped (dev mode adds a
# simulated 3s delay; production logs a warning and proceeds).
TURNSTILE_SECRET=

# Webhook that receives feedback submissions (Discord webhook).
# Optional: when unset, feedback is logged to the console instead.
FEEDBACK_WEBHOOK_URL=
