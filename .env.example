# Copy to `.env` for local development. Values here are for local dev only —
# production values live in GitHub Actions secrets / Worker secrets.

# Public Turnstile site key. Inlined into the client bundle at build time, so
# the build environment must provide it (GitHub Actions secret/variable
# PUBLIC_TURNSTILE_SITEKEY in CI). The value below is Cloudflare's
# always-pass test key; use the real site key for production.
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Server-side secrets, loaded for local development. In production the same
# names must exist as Worker secrets (`wrangler secret put TURNSTILE_SECRET`).
TURNSTILE_SECRET=
FEEDBACK_WEBHOOK_URL=

# ── GitHub App (edit existing repository feature) ─────────────────────────
# Required only for "Edit existing repository". See docs/deployment.md for
# full setup instructions. Client ID, client secret, and session secret must
# all be set for the GitHub actions to be enabled; the app slug is required
# for the app-installation link.

# Client ID of the GitHub App (NOT the App ID).
PUBLIC_GITHUB_CLIENT_ID=

# URL slug of the GitHub App, e.g. "shield-wizard" for
# https://github.com/apps/shield-wizard.
PUBLIC_GITHUB_APP_SLUG=

# Client secret generated in the GitHub App settings.
GITHUB_CLIENT_SECRET=

# Long random string used to encrypt the GitHub token in the stateless
# session cookie and to sign OAuth state. Generate one with:
#   openssl rand -base64 32
# In production this MUST be a Cloudflare secret, not a plain `vars` value.
GITHUB_SESSION_SECRET=

# Optional local-development only: HTTP CONNECT proxy used for GitHub API
# calls while running `astro dev`. Ignored in production builds.
# GITHUB_HTTP_PROXY=http://proxy:20171
