# Copy to `.env` for local development. Values here are for local dev only —
# production values live in GitHub Actions secrets / Worker secrets.

# Public Turnstile site key. Inlined into the client bundle at build time, so
# the build environment must provide it (GitHub Actions secret/variable
# PUBLIC_TURNSTILE_SITEKEY in CI). The value below is Cloudflare's
# always-pass test key; use the real site key for production.
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Server-side secrets, loaded for local development. In production the same
# names must exist as Worker secrets (`wrangler secret put TURNSTILE_SECRET`).
TURNSTILE_SECRET=
FEEDBACK_WEBHOOK_URL=
